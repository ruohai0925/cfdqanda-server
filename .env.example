# Supabase credentials (service_role key, bypasses RLS)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Supabase JWT secret (from Dashboard → Settings → API → JWT Secret)
# Required for API endpoint authentication
SUPABASE_JWT_SECRET=

# OpenAI API key — required for the embedding provider (text-embedding-3-small).
# Note: The default LLM provider is 'openai-codex' which uses ChatGPT OAuth
# (via ~/.codex/auth.json), NOT this API key. This key is only for embeddings.
# Also used as fallback when a user selects the 'openai' provider without BYOK.
OPENAI_API_KEY=

# OpenFOAM installation path
WM_PROJECT_DIR=/opt/openfoam10

# Additional CORS origins (comma-separated)
EXTRA_CORS_ORIGINS=

# Path to the Foam-Agent repository (required)
FOAM_AGENT_DIR=/path/to/Foam-Agent

# Simulation subprocess timeout in seconds (default: 3600 = 1 hour)
SIMULATION_TIMEOUT=1200

# Stale job recovery threshold in seconds (default: 7200 = 2 hours)
# On startup, Worker resets 'running' jobs older than this to 'queued'.
STALE_JOB_THRESHOLD=7200

# Path to cfdqanda-middleware repository (optional, enables checkpoint pre-run)
# If not set, checkpoint mechanism is disabled and jobs run directly to completion.
MIDDLEWARE_DIR=/path/to/cfdqanda-middleware

# Pre-run subprocess timeout in seconds (default: 300 = 5 minutes)
# Much shorter than full simulation timeout since pre-run only runs ~10 timesteps.
PRE_RUN_TIMEOUT=300

# Worker health check URL — used by the admin status endpoint (GET /api/v1/admin/status).
# Bare metal: http://localhost:8001/health (default)
# Docker Compose: set automatically via docker-compose.yml to http://worker:8001/health
WORKER_HEALTH_URL=http://localhost:8001/health

# --- User quota ---

# Max cloud storage per user in MB (default: 2048 = 2 GB)
USER_STORAGE_LIMIT_MB=2048

# Max tasks a user can submit per day (default: 10, resets at UTC midnight)
USER_DAILY_TASK_LIMIT=10

# Admin/test emails exempt from daily task limit (comma-separated, optional)
# QUOTA_EXEMPT_EMAILS=admin@example.com,tester@example.com

# --- Docker-specific (only used by docker-compose.yml) ---

# Host path to Foam-Agent repo, bind-mounted into the Worker container.
# Inside the container, this becomes /home/openfoam/Foam-Agent.
# Only needed when running via docker compose (not for bare-metal).
FOAM_AGENT_HOST_PATH=/path/to/Foam-Agent

# Host path to cfdqanda-middleware repo, bind-mounted into the Worker container.
# Inside the container, this becomes /app/middleware.
# docker-compose.yml overrides MIDDLEWARE_DIR to /app/middleware automatically.
MIDDLEWARE_HOST_PATH=/path/to/cfdqanda-middleware
