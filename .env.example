# Supabase credentials (service_role key, bypasses RLS)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Default OpenAI API key (used when user does not provide their own)
OPENAI_API_KEY=

# OpenFOAM installation path
WM_PROJECT_DIR=/opt/openfoam10

# Additional CORS origins (comma-separated)
EXTRA_CORS_ORIGINS=

# Path to the Foam-Agent repository (required)
FOAM_AGENT_DIR=/path/to/Foam-Agent

# Simulation subprocess timeout in seconds (default: 3600 = 1 hour)
SIMULATION_TIMEOUT=1200
